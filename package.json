{
  "name": "rippling-cli",
  "version": "0.1.1",
  "description": "rpl - Rippling CLI with RPass password-manager support",
  "type": "module",
  "bin": {
    "rpl": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "rippling",
    "rpass",
    "cli",
    "password-manager",
    "totp"
  ],
  "author": "Duc Nguyen",
  "license": "MIT",
  "homepage": "https://github.com/vanducng/rippling-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanducng/rippling-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vanducng/rippling-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "classic-level": "^1.4.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
